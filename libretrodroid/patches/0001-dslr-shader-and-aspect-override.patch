+// ---------------------------------------------------------------------------------------------
+// DSLR / cinematic lens look (DragonNES).
+// Pass 0 + 1: separable gaussian blur at half resolution (feeds bloom and depth of field).
+// Pass 2: sharp pixel-art upscale + chromatic aberration + depth of field + bloom
+//         + colour grading + vignette + animated film grain.
+// ---------------------------------------------------------------------------------------------
+
+const std::unordered_map<std::string, std::string> ShaderManager::dslrParams = {
+    { "DSLR_BLOOM", "0.55" },
+    { "DSLR_BLOOM_THRESHOLD", "0.6" },
+    { "DSLR_DOF", "0.45" },
+    { "DSLR_VIGNETTE", "0.45" },
+    { "DSLR_ABERRATION", "0.35" },
+    { "DSLR_GRAIN", "0.25" },
+    { "DSLR_GRADE", "1" },
+    { "DSLR_BLUR_RADIUS", "2.0" },
+    { "DSLR_HD", "0" },
+};
+
+// Hyllian's xBR level 2: edge-directed HD upscaler for pixel art (single pass).
+const std::string ShaderManager::xbrFragment =
+    "#ifdef GL_FRAGMENT_PRECISION_HIGH\n"
+    "#define HIGHP highp\n"
+    "#else\n"
+    "#define HIGHP mediump\n"
+    "#endif\n"
+    "precision mediump float;\n"
+    "uniform lowp sampler2D texture;\n"
+    "uniform HIGHP vec2 textureSize;\n"
+    "uniform mediump float screenDensity;\n"
+    "varying HIGHP vec2 coords;\n"
+    "\n"
+    "// Hyllian's xBR level 2 (edge-directed pixel-art upscaler), GLSL ES 1.0 port for DragonNES.\n"
+    "#define XBR_EQ 15.0\n"
+    "#define XBR_COEF 2.0\n"
+    "\n"
+    "const vec3 Y = vec3(14.352, 28.176, 5.472);\n"
+    "const vec4 Ao = vec4( 1.0, -1.0, -1.0,  1.0);\n"
+    "const vec4 Bo = vec4( 1.0,  1.0, -1.0, -1.0);\n"
+    "const vec4 Co = vec4( 1.5,  0.5, -0.5,  0.5);\n"
+    "const vec4 Ax = vec4( 1.0, -1.0, -1.0,  1.0);\n"
+    "const vec4 Bx = vec4( 0.5,  2.0, -0.5, -2.0);\n"
+    "const vec4 Cx = vec4( 1.0,  1.0, -0.5,  0.0);\n"
+    "const vec4 Ay = vec4( 1.0, -1.0, -1.0,  1.0);\n"
+    "const vec4 By = vec4( 2.0,  0.5, -2.0, -0.5);\n"
+    "const vec4 Cy = vec4( 2.0,  0.0, -1.0,  0.5);\n"
+    "\n"
+    "vec4 df(vec4 a, vec4 b) { return abs(a - b); }\n"
+    "vec4 eq(vec4 a, vec4 b) { return step(df(a, b), vec4(XBR_EQ)); }\n"
+    "vec4 neq(vec4 a, vec4 b) { return 1.0 - eq(a, b); }\n"
+    "vec4 ne(vec4 a, vec4 b) { return step(vec4(0.0001), df(a, b)); }\n"
+    "vec4 wd(vec4 a, vec4 b, vec4 c, vec4 d, vec4 e, vec4 f, vec4 g, vec4 h) {\n"
+    "  return df(a, b) + df(a, c) + df(d, e) + df(d, f) + 4.0 * df(g, h);\n"
+    "}\n"
+    "\n"
+    "HIGHP vec2 texel;\n"
+    "HIGHP vec2 base;\n"
+    "vec3 T(float x, float y) { return texture2D(texture, base + vec2(x, y) * texel).rgb; }\n"
+    "\n"
+    "void main() {\n"
+    "  texel = 1.0 / textureSize;\n"
+    "  HIGHP vec2 pos = coords * textureSize;\n"
+    "  HIGHP vec2 fp = fract(pos);\n"
+    "  base = (floor(pos) + 0.5) * texel;\n"
+    "\n"
+    "  vec3 A1 = T(-1.0, -2.0), B1 = T(0.0, -2.0), C1 = T(1.0, -2.0);\n"
+    "  vec3 A0 = T(-2.0, -1.0), A = T(-1.0, -1.0), B = T(0.0, -1.0), C = T(1.0, -1.0), C4 = T(2.0, -1.0);\n"
+    "  vec3 D0 = T(-2.0,  0.0), D = T(-1.0,  0.0), E = T(0.0,  0.0), F = T(1.0,  0.0), F4 = T(2.0,  0.0);\n"
+    "  vec3 G0 = T(-2.0,  1.0), G = T(-1.0,  1.0), H = T(0.0,  1.0), I = T(1.0,  1.0), I4 = T(2.0,  1.0);\n"
+    "  vec3 G5 = T(-1.0,  2.0), H5 = T(0.0,  2.0), I5 = T(1.0,  2.0);\n"
+    "\n"
+    "  vec4 b = vec4(dot(B, Y), dot(D, Y), dot(H, Y), dot(F, Y));\n"
+    "  vec4 c = vec4(dot(C, Y), dot(A, Y), dot(G, Y), dot(I, Y));\n"
+    "  vec4 e = vec4(dot(E, Y));\n"
+    "  vec4 d = b.yzwx;\n"
+    "  vec4 f = b.wxyz;\n"
+    "  vec4 g = c.zwxy;\n"
+    "  vec4 h = b.zwxy;\n"
+    "  vec4 i = c.wxyz;\n"
+    "  vec4 i4 = vec4(dot(I4, Y), dot(C1, Y), dot(A0, Y), dot(G5, Y));\n"
+    "  vec4 i5 = vec4(dot(I5, Y), dot(C4, Y), dot(A1, Y), dot(G0, Y));\n"
+    "  vec4 h5 = vec4(dot(H5, Y), dot(F4, Y), dot(B1, Y), dot(D0, Y));\n"
+    "  vec4 f4 = h5.yzwx;\n"
+    "\n"
+    "  // Anti-aliased line tests (width = about one screen pixel).\n"
+    "  float dlt = clamp(1.0 / max(screenDensity, 1.0), 0.05, 0.5);\n"
+    "  vec4 fx   = Ao * fp.y + Bo * fp.x;\n"
+    "  vec4 fx_l = Ax * fp.y + Bx * fp.x;\n"
+    "  vec4 fx_u = Ay * fp.y + By * fp.x;\n"
+    "  vec4 fx45 = smoothstep(Co - dlt, Co + dlt, fx);\n"
+    "  vec4 fx30 = smoothstep(Cx - dlt, Cx + dlt, fx_l);\n"
+    "  vec4 fx60 = smoothstep(Cy - dlt, Cy + dlt, fx_u);\n"
+    "\n"
+    "  vec4 restr = ne(e, f) * ne(e, h) * clamp(\n"
+    "      neq(f, b) * neq(f, c) + neq(h, d) * neq(h, g)\n"
+    "    + eq(e, i) * clamp(neq(f, f4) * neq(f, i4) + neq(h, h5) * neq(h, i5), 0.0, 1.0)\n"
+    "    + eq(e, g) + eq(e, c), 0.0, 1.0);\n"
+    "  vec4 restr_l = ne(e, g) * ne(d, g);\n"
+    "  vec4 restr_u = ne(e, c) * ne(b, c);\n"
+    "\n"
+    "  vec4 edr   = step(wd(e, c, g, i, h5, f4, h, f) + 0.0001, wd(h, d, i5, f, i4, b, e, i)) * restr;\n"
+    "  vec4 edr_l = step(XBR_COEF * df(f, g), df(h, c)) * restr_l;\n"
+    "  vec4 edr_u = step(XBR_COEF * df(h, c), df(f, g)) * restr_u;\n"
+    "\n"
+    "  vec4 nc45 = edr * fx45;\n"
+    "  vec4 nc30 = edr * edr_l * fx30;\n"
+    "  vec4 nc60 = edr * edr_u * fx60;\n"
+    "  vec4 m = max(max(nc30, nc60), nc45);\n"
+    "\n"
+    "  vec4 px = step(df(e, f), df(e, h));   // 1 -> blend toward f, 0 -> toward h\n"
+    "  vec3 p0 = mix(H, F, px.x);\n"
+    "  vec3 p1 = mix(F, B, px.y);\n"
+    "  vec3 p2 = mix(B, D, px.z);\n"
+    "  vec3 p3 = mix(D, H, px.w);\n"
+    "\n"
+    "  vec3 col = E;\n"
+    "  col = mix(col, p0, m.x);\n"
+    "  col = mix(col, p1, m.y);\n"
+    "  col = mix(col, p2, m.z);\n"
+    "  col = mix(col, p3, m.w);\n"
+    "  gl_FragColor = vec4(col, 1.0);\n"
+    "}\n";
+
+
+const std::string ShaderManager::dslrBlurHFragment =
+    "#ifdef GL_FRAGMENT_PRECISION_HIGH\n"
+    "#define HIGHP highp\n"
+    "#else\n"
+    "#define HIGHP mediump\n"
+    "#endif\n"
+    "precision mediump float;\n"
+    "uniform lowp sampler2D texture;\n"
+    "uniform HIGHP vec2 textureSize;\n"
+    "varying HIGHP vec2 coords;\n"
+    "void main() {\n"
+    "  HIGHP vec2 o = vec2(DSLR_BLUR_RADIUS / textureSize.x, 0.0);\n"
+    "  vec3 c = texture2D(texture, coords).rgb * 0.2270270;\n"
+    "  c += texture2D(texture, coords + o * 1.3846154).rgb * 0.3162162;\n"
+    "  c += texture2D(texture, coords - o * 1.3846154).rgb * 0.3162162;\n"
+    "  c += texture2D(texture, coords + o * 3.2307692).rgb * 0.0702703;\n"
+    "  c += texture2D(texture, coords - o * 3.2307692).rgb * 0.0702703;\n"
+    "  gl_FragColor = vec4(c, 1.0);\n"
+    "}\n";
+
+const std::string ShaderManager::dslrBlurVFragment =
+    "#ifdef GL_FRAGMENT_PRECISION_HIGH\n"
+    "#define HIGHP highp\n"
+    "#else\n"
+    "#define HIGHP mediump\n"
+    "#endif\n"
+    "precision mediump float;\n"
+    "uniform lowp sampler2D previousPass;\n"
+    "uniform HIGHP vec2 textureSize;\n"
+    "varying HIGHP vec2 coords;\n"
+    "void main() {\n"
+    "  HIGHP vec2 o = vec2(0.0, DSLR_BLUR_RADIUS / textureSize.y);\n"
+    "  vec3 c = texture2D(previousPass, coords).rgb * 0.2270270;\n"
+    "  c += texture2D(previousPass, coords + o * 1.3846154).rgb * 0.3162162;\n"
+    "  c += texture2D(previousPass, coords - o * 1.3846154).rgb * 0.3162162;\n"
+    "  c += texture2D(previousPass, coords + o * 3.2307692).rgb * 0.0702703;\n"
+    "  c += texture2D(previousPass, coords - o * 3.2307692).rgb * 0.0702703;\n"
+    "  gl_FragColor = vec4(c, 1.0);\n"
+    "}\n";
+
+const std::string ShaderManager::dslrFinalFragment =
+    "#ifdef GL_FRAGMENT_PRECISION_HIGH\n"
+    "#define HIGHP highp\n"
+    "#else\n"
+    "#define HIGHP mediump\n"
+    "#endif\n"
+    "precision mediump float;\n"
+    "uniform lowp sampler2D texture;\n"
+    "uniform lowp sampler2D previousPass;\n"
+    "uniform lowp sampler2D firstPass;\n"
+    "uniform HIGHP vec2 textureSize;\n"
+    "uniform mediump float screenDensity;\n"
+    "uniform HIGHP float frameCount;\n"
+    "varying HIGHP vec2 coords;\n"
+    "\n"
+    "vec3 sharpSample(HIGHP vec2 uv) {\n"
+    "#if DSLR_HD == 1\n"
+    "  return texture2D(firstPass, uv).rgb;\n"   // xBR-upscaled frame (pass 0)
+    "#endif\n"
+    "  HIGHP vec2 sc = uv * textureSize;\n"
+    "  mediump vec2 threshold = vec2(1.0 / max(screenDensity, 1.0));\n"
+    "  mediump vec2 x = fract(sc);\n"
+    "  x = 0.5 * (smoothstep(vec2(0.0), threshold, x) + smoothstep(vec2(1.0) - threshold, vec2(1.0), x));\n"
+    "  return texture2D(texture, (floor(sc) + x) / textureSize).rgb;\n"
+    "}\n"
+    "\n"
+    "HIGHP float hash(HIGHP vec2 p) {\n"
+    "  HIGHP vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n"
+    "  p3 += dot(p3, p3.yzx + 33.33);\n"
+    "  return fract((p3.x + p3.y) * p3.z);\n"
+    "}\n"
+    "\n"
+    "float luma(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }\n"
+    "\n"
+    "vec3 grade(vec3 c) {\n"
+    "  float l = luma(c);\n"
+    "#if DSLR_GRADE == 1\n"
+    "  // Cinematic: teal shadows, warm highlights, gentle S-curve.\n"
+    "  c = mix(c, c * vec3(0.92, 1.0, 1.06), 1.0 - smoothstep(0.0, 0.45, l));\n"
+    "  c = mix(c, c * vec3(1.06, 1.0, 0.92), smoothstep(0.35, 1.0, l));\n"
+    "  c = mix(c, c * c * (3.0 - 2.0 * c), 0.25);\n"
+    "  c = mix(vec3(luma(c)), c, 0.95);\n"
+    "#elif DSLR_GRADE == 2\n"
+    "  // Cold night lens.\n"
+    "  c = c * vec3(0.90, 0.98, 1.12);\n"
+    "  c = mix(c, c * c * (3.0 - 2.0 * c), 0.25);\n"
+    "#elif DSLR_GRADE == 3\n"
+    "  // Vintage film: lifted blacks, warm and slightly faded.\n"
+    "  c = c * vec3(1.06, 1.0, 0.88) * 0.92 + vec3(0.05, 0.04, 0.03);\n"
+    "  c = mix(vec3(luma(c)), c, 0.82);\n"
+    "#elif DSLR_GRADE == 4\n"
+    "  // Vivid: punchy contrast and saturation.\n"
+    "  c = mix(c, c * c * (3.0 - 2.0 * c), 0.5);\n"
+    "  c = mix(vec3(luma(c)), c, 1.2);\n"
+    "#endif\n"
+    "  return c;\n"
+    "}\n"
+    "\n"
+    "void main() {\n"
+    "  HIGHP vec2 uv = coords;\n"
+    "  vec2 d = uv - vec2(0.5);\n"
+    "  float r2 = dot(d, d) * 2.0;\n"   // 0 at centre, ~1 in the corners
+    "\n"
+    "  vec3 col;\n"
+    "  HIGHP vec2 ca = d * (DSLR_ABERRATION * 1.5) / textureSize.x * r2 * 4.0;\n"
+    "  col.r = sharpSample(uv + ca).r;\n"
+    "  col.g = sharpSample(uv).g;\n"
+    "  col.b = sharpSample(uv - ca).b;\n"
+    "\n"
+    "  vec3 blur = texture2D(previousPass, uv).rgb;\n"
+    "\n"
+    "  // Depth of field: the centre stays in focus, the edges fall off like a wide-open lens.\n"
+    "  float dof = DSLR_DOF * smoothstep(0.18, 0.95, r2);\n"
+    "  col = mix(col, blur, dof);\n"
+    "\n"
+    "  // Bloom: only the bright parts of the blurred image glow.\n"
+    "  float bl = luma(blur);\n"
+    "  vec3 bright = blur * smoothstep(DSLR_BLOOM_THRESHOLD, 1.0, bl);\n"
+    "  col = 1.0 - (1.0 - col) * (1.0 - bright * DSLR_BLOOM * 1.6);\n"
+    "\n"
+    "  col = grade(clamp(col, 0.0, 1.0));\n"
+    "\n"
+    "  // Optical vignette.\n"
+    "  col *= 1.0 - DSLR_VIGNETTE * smoothstep(0.25, 1.15, r2);\n"
+    "\n"
+    "  // Animated film grain, per screen pixel, stronger in the mid-tones.\n"
+    "  HIGHP float n = hash(gl_FragCoord.xy + vec2(frameCount * 37.0, frameCount * 17.0)) - 0.5;\n"
+    "  float l = luma(col);\n"
+    "  col += n * DSLR_GRAIN * 0.12 * (1.0 - abs(l - 0.5) * 1.2);\n"
+    "\n"
+    "  gl_FragColor = vec4(clamp(col, 0.0, 1.0), 1.0);\n"
+    "}\n";
+
