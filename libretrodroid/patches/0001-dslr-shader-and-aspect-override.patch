     switch (config.type) {
     case Type::SHADER_DEFAULT: {
@@ -1602,7 +1860,37 @@ ShaderManager::Chain ShaderManager::getShader(const ShaderManager::Config& confi
             false
         };
     }
+
+    case Type::SHADER_HD: {
+        return { { { defaultShaderVertex, xbrFragment, true, 1.0 } }, true };
+    }
+
+    case Type::SHADER_DSLR: {
+        std::string defines = buildDefines(dslrParams, config.params);
+        auto hd = config.params.find("DSLR_HD");
+        if (hd != config.params.end() && hd->second == "1") {
+            // xBR at 4x into an offscreen buffer, then the lens effects read it as "firstPass".
+            return {
+                {
+                    { defaultShaderVertex, xbrFragment, true, 4.0 },
+                    { defines + defaultShaderVertex, defines + dslrBlurHFragment, true, 0.5 },
+                    { defines + defaultShaderVertex, defines + dslrBlurVFragment, true, 0.5 },
+                    { defines + defaultShaderVertex, defines + dslrFinalFragment, true, 1.0 },
+                },
+                true
+            };
+        }
+        return {
+            {
+                { defines + defaultShaderVertex, defines + dslrBlurHFragment, true, 0.5 },
+                { defines + defaultShaderVertex, defines + dslrBlurVFragment, true, 0.5 },
+                { defines + defaultShaderVertex, defines + dslrFinalFragment, true, 1.0 },
+            },
+            true
+        };
+    }
 }
+return getShader({ Type::SHADER_DEFAULT, {} });
 }
 
