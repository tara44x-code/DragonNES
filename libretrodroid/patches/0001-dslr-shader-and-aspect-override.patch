+// ---------------------------------------------------------------------------------------------
+// DSLR / cinematic lens look (DragonNES).
+// Pass 0 + 1: separable gaussian blur at half resolution (feeds bloom and depth of field).
+// Pass 2: sharp pixel-art upscale + chromatic aberration + depth of field + bloom
+//         + colour grading + vignette + animated film grain.
+// ---------------------------------------------------------------------------------------------
+
+const std::unordered_map<std::string, std::string> ShaderManager::dslrParams = {
+    { "DSLR_BLOOM", "0.55" },
+    { "DSLR_BLOOM_THRESHOLD", "0.6" },
+    { "DSLR_DOF", "0.45" },
+    { "DSLR_VIGNETTE", "0.45" },
+    { "DSLR_ABERRATION", "0.35" },
+    { "DSLR_GRAIN", "0.25" },
+    { "DSLR_GRADE", "1" },
+    { "DSLR_BLUR_RADIUS", "2.0" },
+};
+
+const std::string ShaderManager::dslrBlurHFragment =
+    "#ifdef GL_FRAGMENT_PRECISION_HIGH\n"
+    "#define HIGHP highp\n"
+    "#else\n"
+    "#define HIGHP mediump\n"
+    "#endif\n"
+    "precision mediump float;\n"
+    "uniform lowp sampler2D texture;\n"
+    "uniform HIGHP vec2 textureSize;\n"
+    "varying HIGHP vec2 coords;\n"
+    "void main() {\n"
+    "  HIGHP vec2 o = vec2(DSLR_BLUR_RADIUS / textureSize.x, 0.0);\n"
+    "  vec3 c = texture2D(texture, coords).rgb * 0.2270270;\n"
+    "  c += texture2D(texture, coords + o * 1.3846154).rgb * 0.3162162;\n"
+    "  c += texture2D(texture, coords - o * 1.3846154).rgb * 0.3162162;\n"
+    "  c += texture2D(texture, coords + o * 3.2307692).rgb * 0.0702703;\n"
+    "  c += texture2D(texture, coords - o * 3.2307692).rgb * 0.0702703;\n"
+    "  gl_FragColor = vec4(c, 1.0);\n"
+    "}\n";
+
+const std::string ShaderManager::dslrBlurVFragment =
+    "#ifdef GL_FRAGMENT_PRECISION_HIGH\n"
+    "#define HIGHP highp\n"
+    "#else\n"
+    "#define HIGHP mediump\n"
+    "#endif\n"
+    "precision mediump float;\n"
+    "uniform lowp sampler2D previousPass;\n"
+    "uniform HIGHP vec2 textureSize;\n"
+    "varying HIGHP vec2 coords;\n"
+    "void main() {\n"
+    "  HIGHP vec2 o = vec2(0.0, DSLR_BLUR_RADIUS / textureSize.y);\n"
+    "  vec3 c = texture2D(previousPass, coords).rgb * 0.2270270;\n"
+    "  c += texture2D(previousPass, coords + o * 1.3846154).rgb * 0.3162162;\n"
+    "  c += texture2D(previousPass, coords - o * 1.3846154).rgb * 0.3162162;\n"
+    "  c += texture2D(previousPass, coords + o * 3.2307692).rgb * 0.0702703;\n"
+    "  c += texture2D(previousPass, coords - o * 3.2307692).rgb * 0.0702703;\n"
+    "  gl_FragColor = vec4(c, 1.0);\n"
+    "}\n";
+
+const std::string ShaderManager::dslrFinalFragment =
+    "#ifdef GL_FRAGMENT_PRECISION_HIGH\n"
+    "#define HIGHP highp\n"
+    "#else\n"
+    "#define HIGHP mediump\n"
+    "#endif\n"
+    "precision mediump float;\n"
+    "uniform lowp sampler2D texture;\n"
+    "uniform lowp sampler2D previousPass;\n"
+    "uniform HIGHP vec2 textureSize;\n"
+    "uniform mediump float screenDensity;\n"
+    "uniform HIGHP float frameCount;\n"
+    "varying HIGHP vec2 coords;\n"
+    "\n"
+    "vec3 sharpSample(HIGHP vec2 uv) {\n"
+    "  HIGHP vec2 sc = uv * textureSize;\n"
+    "  mediump vec2 threshold = vec2(1.0 / max(screenDensity, 1.0));\n"
+    "  mediump vec2 x = fract(sc);\n"
+    "  x = 0.5 * (smoothstep(vec2(0.0), threshold, x) + smoothstep(vec2(1.0) - threshold, vec2(1.0), x));\n"
+    "  return texture2D(texture, (floor(sc) + x) / textureSize).rgb;\n"
+    "}\n"
+    "\n"
+    "HIGHP float hash(HIGHP vec2 p) {\n"
+    "  HIGHP vec3 p3 = fract(vec3(p.xyx) * 0.1031);\n"
+    "  p3 += dot(p3, p3.yzx + 33.33);\n"
+    "  return fract((p3.x + p3.y) * p3.z);\n"
+    "}\n"
+    "\n"
+    "float luma(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }\n"
+    "\n"
+    "vec3 grade(vec3 c) {\n"
+    "  float l = luma(c);\n"
+    "#if DSLR_GRADE == 1\n"
+    "  // Cinematic: teal shadows, warm highlights, gentle S-curve.\n"
+    "  c = mix(c, c * vec3(0.92, 1.0, 1.06), 1.0 - smoothstep(0.0, 0.45, l));\n"
+    "  c = mix(c, c * vec3(1.06, 1.0, 0.92), smoothstep(0.35, 1.0, l));\n"
+    "  c = mix(c, c * c * (3.0 - 2.0 * c), 0.25);\n"
+    "  c = mix(vec3(luma(c)), c, 0.95);\n"
+    "#elif DSLR_GRADE == 2\n"
+    "  // Cold night lens.\n"
+    "  c = c * vec3(0.90, 0.98, 1.12);\n"
+    "  c = mix(c, c * c * (3.0 - 2.0 * c), 0.25);\n"
+    "#elif DSLR_GRADE == 3\n"
+    "  // Vintage film: lifted blacks, warm and slightly faded.\n"
+    "  c = c * vec3(1.06, 1.0, 0.88) * 0.92 + vec3(0.05, 0.04, 0.03);\n"
+    "  c = mix(vec3(luma(c)), c, 0.82);\n"
+    "#elif DSLR_GRADE == 4\n"
+    "  // Vivid: punchy contrast and saturation.\n"
+    "  c = mix(c, c * c * (3.0 - 2.0 * c), 0.5);\n"
+    "  c = mix(vec3(luma(c)), c, 1.2);\n"
+    "#endif\n"
+    "  return c;\n"
+    "}\n"
+    "\n"
+    "void main() {\n"
+    "  HIGHP vec2 uv = coords;\n"
+    "  vec2 d = uv - vec2(0.5);\n"
+    "  float r2 = dot(d, d) * 2.0;\n"   // 0 at centre, ~1 in the corners
+    "\n"
+    "  vec3 col;\n"
+    "  HIGHP vec2 ca = d * (DSLR_ABERRATION * 1.5) / textureSize.x * r2 * 4.0;\n"
+    "  col.r = sharpSample(uv + ca).r;\n"
+    "  col.g = sharpSample(uv).g;\n"
+    "  col.b = sharpSample(uv - ca).b;\n"
+    "\n"
+    "  vec3 blur = texture2D(previousPass, uv).rgb;\n"
+    "\n"
+    "  // Depth of field: the centre stays in focus, the edges fall off like a wide-open lens.\n"
+    "  float dof = DSLR_DOF * smoothstep(0.18, 0.95, r2);\n"
+    "  col = mix(col, blur, dof);\n"
+    "\n"
+    "  // Bloom: only the bright parts of the blurred image glow.\n"
+    "  float bl = luma(blur);\n"
+    "  vec3 bright = blur * smoothstep(DSLR_BLOOM_THRESHOLD, 1.0, bl);\n"
+    "  col = 1.0 - (1.0 - col) * (1.0 - bright * DSLR_BLOOM * 1.6);\n"
+    "\n"
+    "  col = grade(clamp(col, 0.0, 1.0));\n"
+    "\n"
+    "  // Optical vignette.\n"
+    "  col *= 1.0 - DSLR_VIGNETTE * smoothstep(0.25, 1.15, r2);\n"
+    "\n"
+    "  // Animated film grain, per screen pixel, stronger in the mid-tones.\n"
+    "  HIGHP float n = hash(gl_FragCoord.xy + vec2(frameCount * 37.0, frameCount * 17.0)) - 0.5;\n"
+    "  float l = luma(col);\n"
+    "  col += n * DSLR_GRAIN * 0.12 * (1.0 - abs(l - 0.5) * 1.2);\n"
+    "\n"
+    "  gl_FragColor = vec4(clamp(col, 0.0, 1.0), 1.0);\n"
+    "}\n";
+
 ShaderManager::Chain ShaderManager::getShader(const ShaderManager::Config& config) {
     switch (config.type) {
     case Type::SHADER_DEFAULT: {
@@ -1602,7 +1750,20 @@ ShaderManager::Chain ShaderManager::getShader(const ShaderManager::Config& confi
             false
         };
     }
+
+    case Type::SHADER_DSLR: {
+        std::string defines = buildDefines(dslrParams, config.params);
+        return {
+            {
+                { defines + defaultShaderVertex, defines + dslrBlurHFragment, true, 0.5 },
+                { defines + defaultShaderVertex, defines + dslrBlurVFragment, true, 0.5 },
+                { defines + defaultShaderVertex, defines + dslrFinalFragment, true, 1.0 },
+            },
+            true
+        };
+    }
 }
+return getShader({ Type::SHADER_DEFAULT, {} });
 }
 
